# Flask Configuration
SECRET_KEY=narayana-lnd-lms-super-secret-key-2026
FLASK_ENV=production

# Database Configuration (PostgreSQL on Render, SQLite fallback for local dev)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Backblaze B2 Cloud Storage Configuration
# Obtain these credentials from Backblaze B2 Console -> App Keys & Buckets
B2_KEY_ID=your_backblaze_key_id
B2_APPLICATION_KEY=your_backblaze_application_key
B2_BUCKET_NAME=your_backblaze_bucket_name
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Feature Flags
ENABLE_CONTENT_AUTHORING=False
